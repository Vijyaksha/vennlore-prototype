# Copy to .env.local and fill in. Placeholder values only; never commit real ones.

# Who Kindred shows picks for. Set at most ONE of these two.
# - Unset, empty or whitespace-only counts as unset.
# - A set value must be a whole number (presenter id >= 1, talk id >= 0), surrounding
#   whitespace allowed. Anything else FAILS the build with an error naming the variable.
# - If both are set, NEXT_PUBLIC_PRESENTER_ID wins and NEXT_PUBLIC_ANCHOR_TALK_ID is
#   ignored (warned about outside production).
# - With neither set, the app uses anchor talk 0.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.
# NEXT_PUBLIC_PRESENTER_ID=123
NEXT_PUBLIC_ANCHOR_TALK_ID=0

# Engine whose recommendation rows the API reads (server-side). Defaults to graph_v1.
ENGINE_ID=graph_v1

# Postgres connection string for the API (server-side only).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Local e2e against a throwaway Postgres (needs Docker). Run from the repo root:
#   docker compose up -d postgres
#   export DATABASE_URL=postgres://kindred:kindred@localhost:5432/kindred
#   export SEED_PATH=$PWD/apps/web/e2e/fixtures/app_seed.v2.json
#   npm run db:migrate --workspace=@repo/api && npm run db:seed --workspace=@repo/api
#   npm run build --workspace=web && npm run e2e --workspace=web
