# Copy to .env.local and fill in. Placeholder values only; never commit real ones.

# Who Kindred shows picks for. Set at most ONE of these two.
# Precedence: if both are set, NEXT_PUBLIC_PRESENTER_ID wins, NEXT_PUBLIC_ANCHOR_TALK_ID
# is ignored, and a warning is logged. A malformed value (not a whole number, or a
# presenter id below 1) is ignored with a warning. With nothing valid set, the app
# uses anchor talk 0. NEXT_PUBLIC_* values are inlined at build time: rebuild after
# changing them.
# NEXT_PUBLIC_PRESENTER_ID=123
NEXT_PUBLIC_ANCHOR_TALK_ID=0

# Engine whose recommendation rows the API reads (server-side). Defaults to graph_v1.
ENGINE_ID=graph_v1

# Postgres connection string for the API (server-side only).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
