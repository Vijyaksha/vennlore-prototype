{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "for_talk_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidate_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "match": {
      "type": "boolean"
    },
    "cross_domain": {
      "type": "boolean"
    },
    "why": {
      "type": "string"
    },
    "strongest_parallel": {
      "type": "string"
    },
    "shared_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "number",
      "const": 1
    }
  },
  "required": [
    "for_talk_id",
    "candidate_id",
    "score",
    "rank",
    "match",
    "cross_domain",
    "why",
    "strongest_parallel",
    "shared_methods",
    "evidence",
    "engine_id",
    "run_id",
    "contract_version"
  ],
  "additionalProperties": false,
  "title": "Recommendation"
}
